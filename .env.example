# ==============================================================================
# DAIMASU Reservation System — environment variables
# Copy to .env.local for development. Production values live in Vultr secrets
# (see docs/SETUP.md and .github/workflows/deploy.yml).
# ==============================================================================

# ── Supabase ─────────────────────────────────────────────────────────────────
# Project URL and keys from https://app.supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...                # public anon
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...                    # ⚠️ SERVER-ONLY. Never expose to client.

# ── Stripe (PHP-denominated) ─────────────────────────────────────────────────
# Get from https://dashboard.stripe.com → Developers → API keys
# Use test keys (sk_test_…) for development. Live keys for production only.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...                            # from `stripe listen` or dashboard
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── Resend (transactional email) ─────────────────────────────────────────────
# https://resend.com → API Keys
RESEND_API_KEY=re_...

# ── Twilio (WhatsApp Business reminders — optional) ──────────────────────────
# Leave blank in dev to fall back to email-only reminders.
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...

# ── Telegram fallback ─────────────────────────────────────────────────────────
# Existing values from prior landing-page integration. Settings-table values
# take precedence; these are env fallbacks for cold start before owner sets them.
TELEGRAM_BOT_TOKEN_FALLBACK=
TELEGRAM_CHAT_ID_FALLBACK=

# ── Self-cancel HMAC secret ──────────────────────────────────────────────────
# Random ≥ 32 chars. Used to sign self-cancel URLs sent by email.
# Generate: openssl rand -base64 48
CANCEL_TOKEN_SECRET=

# ── Public site URL ───────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://bar.daimasu.com.ph

# ── Restaurant timezone (default Asia/Manila) ─────────────────────────────────
RESTAURANT_TIMEZONE=Asia/Manila

# ── Node env ──────────────────────────────────────────────────────────────────
NODE_ENV=development
